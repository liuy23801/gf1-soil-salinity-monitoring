# Python caches and build output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local Python environments and editor settings
.venv/
venv/
env/
.idea/
.vscode/

# Local credentials and configuration
.env
.env.*
!.env.example
config.local.py
config.local.json
local_settings.py
*.pem
*.key

