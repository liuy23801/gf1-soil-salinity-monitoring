# Operating-system and temporary files
.DS_Store
Thumbs.db
Desktop.ini
~$*
*.tmp

# Keep source code, HTML, CSS, JS, fonts, CSV samples and PNG/JPG assets.
# These rules do not remove secrets embedded in tracked source files.
